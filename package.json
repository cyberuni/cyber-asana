{
	"name": "cyber-asana-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"ca": "pnpm run --filter=./packages/cyber-asana",
		"check": "biome check",
		"check:fix": "biome check --write",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@repobuddy/biome": "^2.5.0",
		"husky": "^9.1.7",
		"knip": "^6.38.0",
		"turbo": "^2.11.5"
	},
	"packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
	"engines": {
		"node": ">=22"
	}
}
