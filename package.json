{
	"name": "cyber-asana-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"ca": "pnpm run --filter=./packages/cyber-asana",
		"check": "biome check",
		"check:fix": "biome check --write",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@repobuddy/biome": "^2.5.0",
		"husky": "^9.1.7",
		"knip": "^6.38.0",
		"turbo": "^2.11.5"
	},
	"packageManager": "pnpm@11.28.3+sha512.d49760a13b1755948775a5d4cb1bc4ba871ff2dc941adf851630d044ed722f9b5be8be57bef93166098c80c706bd612c282d05526dd1d0ae660188c086820f35",
	"engines": {
		"node": ">=22"
	}
}
