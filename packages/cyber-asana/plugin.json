{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "cyber-asana",
	"version": "0.31.0",
	"description": "Asana CLI and agent skills, with an opt-in MCP server",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyberuni/cyber-asana",
	"repository": "https://github.com/cyberuni/cyber-asana.git",
	"license": "MIT",
	"keywords": ["asana", "mcp", "cli", "agent", "productivity", "project-management"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"skills": "./skills/",
			"commands": "./commands/",
			"scripts": {
				"skills/asana/scripts/cyber-asana.mjs": { "forward": "cyber-asana" },
				"skills/asana-scrum/scripts/cyber-asana.mjs": { "forward": "cyber-asana" },
				"skills/config-asana/scripts/cyber-asana.mjs": { "forward": "cyber-asana" },
				"skills/init-asana/scripts/cyber-asana.mjs": { "forward": "cyber-asana" },
				"skills/init-asana-scrum/scripts/cyber-asana.mjs": { "forward": "cyber-asana" },
				"skills/sync-asana-project/scripts/cyber-asana.mjs": { "forward": "cyber-asana" },
				"skills/asana/scripts/repobuddy.mjs": { "forward": "repobuddy", "package": "repobuddy", "version": "2.2.0" }
			},
			"vendors": ["claude-code", "cursor", "codex", "copilot-cli"],
			"harnesses": {
				"claude-code": {
					"dependencies": ["cyber-agentkit"]
				},
				"cursor": {
					"category": "productivity",
					"tags": ["asana", "mcp", "project-management"]
				},
				"codex": {
					"interface": {
						"displayName": "Cyber Asana",
						"category": "productivity"
					}
				}
			}
		}
	}
}
